{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "verbatimModuleSyntax": true,
    "rootDir": "..",
    "outDir": "build/declarations",
    "declaration": true,
    "emitDeclarationOnly": true,
    "skipLibCheck": true
  }
}
