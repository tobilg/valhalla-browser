# Public R2 manifest for the historical Liechtenstein 2015 fixture graph.
# Replace with your deployment URL; never put storage credentials here.
# Copy to .env.local in this directory, or set the variable in your shell.
# Leave unset to use the local fixture/MinIO discovery during development.
VITE_DEMO_MANIFEST_URL=https://routing.example.com/datasets/your-release-id/manifest.json

# Optional alternative OSM-derived raster basemap (XYZ tiles). Defaults to
# https://tile.openstreetmap.org/{z}/{x}/{y}.png with visible OSM attribution.
# Replace these examples with your provider's URL and required additional credit.
# Both settings are public and embedded during the Vite build.
# VITE_DEMO_BASEMAP_URL=https://tiles.example.com/{z}/{x}/{y}.png
# VITE_DEMO_BASEMAP_ATTRIBUTION=Your tile provider
