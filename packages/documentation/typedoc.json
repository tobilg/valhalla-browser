{
  "$schema": "https://typedoc.org/schema.json",
  "name": "valhalla-wasm API",
  "entryPoints": [
    "../valhalla-browser/src/client.ts",
    "../valhalla-server/src/node.ts",
    "../valhalla-server/src/cloudflare.ts"
  ],
  "tsconfig": "./tsconfig.json",
  "router": "structure-dir",
  "out": "dist",
  "readme": "../../README.md",
  "plugin": [
    "./readme-theme.js"
  ],
  "theme": "readme-overview",
  "projectDocuments": [
    "guides/*.md",
    "../../docs/building-graph-data.md",
    "../../docs/object-storage-hosting.md",
    "../../docs/server-routing.md"
  ],
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "validation": {
    "notDocumented": true,
    "notExported": true,
    "invalidLink": true
  },
  "packagesRequiringDocumentation": [
    "valhalla-browser",
    "valhalla-server",
    "@tobilg/valhalla-core"
  ],
  "requiredToBeDocumented": [
    "Enum",
    "EnumMember",
    "Variable",
    "Class",
    "Interface",
    "TypeAlias",
    "Function",
    "Constructor",
    "Property",
    "Method",
    "Accessor"
  ],
  "treatWarningsAsErrors": true,
  "titleLink": "/",
  "hostedBaseUrl": "https://valhalla-wasm-api.gh.tobilg.com/",
  "sourceLinkTemplate": "https://github.com/tobilg/valhalla-wasm/blob/{gitRevision}/{path}#L{line}",
  "navigationLinks": {
    "GitHub": "https://github.com/tobilg/valhalla-wasm",
    "npm: browser": "https://www.npmjs.com/package/valhalla-browser",
    "npm: server": "https://www.npmjs.com/package/valhalla-server"
  }
}
